---
import Layout from '../../layouts/Layout.astro';
import LeftSidebar from '../../components/LeftSidebar.astro';
import RightSidebar from '../../components/RightSidebar.astro';
import { getCollection } from 'astro:content';
import { formatDateTime } from '../../lib/format';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const cats = new Set<string>();
  for (const post of posts) {
    if (post.data.category) cats.add(post.data.category);
  }
  return [...cats].map((cat) => ({
    params: { category: cat },
    props: { category: cat },
  }));
}

const { category } = Astro.props;
const allPosts = await getCollection('blog');
const posts = allPosts
  .filter((p) => p.data.category === category)
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const categoryCounts = new Map<string, number>();
for (const post of allPosts) {
  if (post.data.category) {
    categoryCounts.set(post.data.category, (categoryCounts.get(post.data.category) || 0) + 1);
  }
}
const categories = [...categoryCounts.entries()].sort((a, b) => b[1] - a[1]);
---

<Layout title={`分类：${category}`}>
  <div class="home-layout">
    <LeftSidebar />
    <div class="content">
      <nav class="filter-nav glass">
        <a class="filter-item" href="/">全部</a>
        <a class="filter-item" href="/archive/">归档</a>
        {
          categories.map(([cat, count]) => (
            <a class={`filter-item ${cat === category ? 'active' : ''}`} href={`/category/${encodeURIComponent(cat)}/`}>
              {cat}<span class="filter-count">{count}</span>
            </a>
          ))
        }
      </nav>

      <article class="page glass">
        <h1>分类：{category}</h1>
        <ul class="archive-list">
          {
            posts.map((post) => (
              <li class="archive-item">
                <a href={`/blog/${post.id}/`}>
                  <time datetime={post.data.date.toISOString()}>{formatDateTime(post.data.date)}</time>
                  <span class="archive-title">{post.data.title}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </article>
    </div>
    <RightSidebar />
  </div>
</Layout>
