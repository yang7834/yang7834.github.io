---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { formatDate } from '../lib/format';

const donations = (await getCollection('donations')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Layout title="打赏">
  <article class="page glass">
    <h1>打赏</h1>
    <p>如果觉得这个博客对你有帮助，可以请我喝杯咖啡 ☕</p>

    <div class="donate-grid">
      <div class="donate-item">
        <img src="/images/wechat-qr.png" alt="微信扫码" loading="lazy" />
        <span>微信扫码</span>
      </div>
      <div class="donate-item">
        <img src="/images/alipay-qr.png" alt="支付宝扫码" loading="lazy" />
        <span>支付宝扫码</span>
      </div>
    </div>

    <h2 class="donate-list-title">打赏列表</h2>
    <ul class="donate-list">
      {
        donations.map((d) => (
          <li class="donate-list-item">
            <div class="donate-list-head">
              <span class="donate-name">{d.data.name}</span>
              <span class="donate-amount">{d.data.amount}</span>
            </div>
            {d.data.message && <div class="donate-message">{d.data.message}</div>}
            <span class="donate-date">{formatDate(d.data.date)}</span>
          </li>
        ))
      }
    </ul>
  </article>
</Layout>
