---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';
import { formatDateTime } from '../../lib/format';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Layout title={post.data.title} description={post.data.description}>
  <article class="post glass">
    <header class="post-header">
      <div class="post-date">
        <span class="meta-item">
          <svg class="meta-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
          <time datetime={post.data.date.toISOString()}>{formatDateTime(post.data.date)}</time>
        </span>
      </div>
      <h1 class="post-title">{post.data.title}</h1>
      {post.data.description && <p class="post-desc">{post.data.description}</p>}
      {
        post.data.tags.length > 0 && (
          <span class="tag-list">
            {post.data.tags.map((tag) => (
              <span class="tag">#{tag}</span>
            ))}
          </span>
        )
      }
    </header>
    {post.data.cover && (
      <img class="post-cover" src={post.data.cover} alt={post.data.title} />
    )}
    <div class="post-body">
      <Content />
    </div>
  </article>
</Layout>
