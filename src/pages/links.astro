---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import site from '../data/site.json';

const links = await getCollection('links');
---

<Layout title="友链">
  <article class="page glass">
    <h1><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>友链</h1>
    <p class="friend-intro">欢迎交换友链，下面是已收录的好友站点。</p>

    {
      links.length > 0 ? (
        <ul class="friend-list">
          {
            links.map((link) => (
              <li class="friend-item">
                <a href={link.data.url} target="_blank" rel="noopener noreferrer">
                  {link.data.avatar && (
                    <img class="friend-avatar" src={link.data.avatar} alt={link.data.name} width="48" height="48" />
                  )}
                  <div class="friend-info">
                    <span class="friend-name">{link.data.name}</span>
                    {link.data.description && <span class="friend-desc">{link.data.description}</span>}
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      ) : (
        <p class="friend-empty">暂无友链，欢迎来申请～</p>
      )
    }

    <h2 class="friend-apply-title">申请友链</h2>
    <div class="friend-apply">
      <div class="friend-apply-col">
        <h3>我的站点</h3>
        <div class="friend-self">
          <img class="friend-self-avatar" src={site.avatar} alt="头像" width="64" height="64" />
          <div class="friend-self-info">
            <span>站点名称：{site.title}</span>
            <span>站点链接：https://yang7834.github.io</span>
            <span>头像链接：https://yang7834.github.io{site.avatar}</span>
            <span>站点描述：{site.subtitle}</span>
          </div>
        </div>
      </div>
      <div class="friend-apply-col">
        <h3>申请流程</h3>
        <ol class="friend-steps">
          <li>先在你的站点添加本站友链</li>
          <li>在本站留言区留下四个信息：站点名称、站点链接、头像链接、站点描述</li>
          <li>等待审核，通过后即可上墙</li>
        </ol>
      </div>
    </div>

    <h3>注意事项</h3>
    <ul class="friend-notes">
      <li>站点需能正常访问，内容健康、无违法信息</li>
      <li>请先在贵站添加本站友链，再申请</li>
      <li>头像建议使用方形图片，会显示为圆形</li>
      <li>审核通过后展示在列表，长期无法访问可能会移除</li>
    </ul>
  </article>
</Layout>
