---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import site from '../data/site.json';

const links = await getCollection('links');
---

<Layout title="友链">
  <article class="page glass">
    <h1><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>友链</h1>
    <p class="friend-intro">欢迎交换友链，下面是已收录的好友站点。</p>

    {
      links.length > 0 ? (
        <ul class="friend-list">
          {
            links.map((link) => (
              <li class="friend-item">
                <a href={link.data.url} target="_blank" rel="noopener noreferrer">
                  {link.data.avatar && (
                    <img class="friend-avatar" src={link.data.avatar} alt={link.data.name} width="48" height="48" />
                  )}
                  <div class="friend-info">
                    <span class="friend-name">{link.data.name}</span>
                    {link.data.description && <span class="friend-desc">{link.data.description}</span>}
                  </div>
                </a>
              </li>
            ))
          }
        </ul>
      ) : (
        <p class="friend-empty">暂无友链，欢迎来申请～</p>
      )
    }

    <h2 class="friend-apply-title">申请友链</h2>
    <div class="friend-apply">
      <div class="friend-apply-col">
        <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M8 6h13M8 12h13M8 18h13M3 6h.01M3 12h.01M3 18h.01"/></svg>申请流程</h3>
        <ol class="friend-steps">
          <li>
            <span class="step-num"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg></span>
            <span>先在你的站点添加本站友链</span>
          </li>
          <li>
            <span class="step-num"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg></span>
            <div class="step-content">
              <span>在本站留言区按以下模板留言</span>
              <pre class="friend-template">站点名称：你的博客名
站点链接：https://你的博客地址
头像链接：https://你的头像图片地址
站点描述：一句话介绍你的博客</pre>
            </div>
          </li>
          <li>
            <span class="step-num"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg></span>
            <span>等待审核，通过后即可上墙</span>
          </li>
        </ol>
      </div>
      <div class="friend-apply-col">
        <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 10.5L12 3l9 7.5"/><path d="M5 9.5V21h14V9.5"/></svg>我的站点</h3>
        <div class="friend-self">
          <img class="friend-self-avatar" src={site.avatar} alt="头像" width="64" height="64" />
          <div class="friend-self-info">
            <span>站点名称：{site.title}</span>
            <span>站点链接：https://yang7834.github.io</span>
            <span>头像链接：https://yang7834.github.io{site.avatar}</span>
            <span>站点描述：{site.subtitle}</span>
          </div>
        </div>
        <h3><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><path d="M12 9v4M12 17h.01"/></svg>注意事项</h3>
        <ul class="friend-notes">
          <li>站点需能正常访问，内容健康、无违法信息</li>
          <li>请先在贵站添加本站友链，再申请</li>
          <li>头像建议使用方形图片，会显示为圆形</li>
          <li>审核通过后展示在列表，长期无法访问可能会移除</li>
        </ul>
      </div>
    </div>
  </article>
</Layout>
