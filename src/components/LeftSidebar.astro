---
import { getCollection } from 'astro:content';
import site from '../data/site.json';
import { formatDate } from '../lib/format';

const SITE_TITLE = site.title;
const SITE_BIO = site.bio;

const moments = (await getCollection('moments')).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<aside class="sidebar">
  <!-- 个人卡 -->
  <div class="side-card glass profile">
    <img class="profile-avatar" src={site.avatar} alt="头像" />
    <h2 class="profile-name">{SITE_TITLE}</h2>
    <p class="profile-bio">{SITE_BIO}</p>
  </div>

  <!-- 公告 -->
  <div class="side-card glass">
    <h3 class="side-card-title">公告</h3>
    <div class="notice">
      <p>{site.notice}</p>
    </div>
  </div>

  <!-- 最新动态 -->
  <div class="side-card glass">
    <h3 class="side-card-title">最新动态</h3>
    <div class="moment-list">
      {
        moments.map((m) => (
          <div class="moment-item">
            <div class="moment-text">{m.body}</div>
            <span class="moment-date">{formatDate(m.data.date)}</span>
          </div>
        ))
      }
    </div>
  </div>
</aside>
