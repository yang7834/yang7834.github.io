---
import { getCollection } from 'astro:content';
import site from '../data/site.json';
import { formatDateTime } from '../lib/format';

const SITE_NAME = site.name || site.title;
const SITE_BIO = site.bio;

const posts = await getCollection('blog');
const categories = new Set<string>();
const tags = new Set<string>();
for (const post of posts) {
  if (post.data.category) categories.add(post.data.category);
  for (const tag of post.data.tags) tags.add(tag);
}
const categoryList = [...categories].sort();
const tagList = [...tags].sort();

const moments = (await getCollection('moments')).sort((a, b) => {
  if (a.data.sticky && !b.data.sticky) return -1;
  if (!a.data.sticky && b.data.sticky) return 1;
  return b.data.date.getTime() - a.data.date.getTime();
});
---

<aside class="sidebar">
  <!-- 个人卡 -->
  <div class="side-card glass profile">
    <a href="/about/" aria-label="关于我">
      <span class="profile-avatar-wrap">
        <img class="profile-avatar" src={site.avatar} alt="头像" width="96" height="96" />
        <svg class="devil-tail" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M3 20c2-6 6-9.5 10-8.5 2.5.6 4 2.5 4 5 0 1.6-.8 3-2.2 3.6"/><path d="M15 20l4-4.5"/><path d="M19 15.5l-.8 3"/></svg>
      </span>
    </a>
    <h2 class="profile-name">{SITE_NAME}</h2>
    <p class="profile-bio">{SITE_BIO}</p>
  </div>

  <!-- 公告 -->
  <div class="side-card glass">
    <h3 class="side-card-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11v2a1 1 0 0 0 1 1h2l4 4V6l-4 4H4a1 1 0 0 0-1 1z"/><path d="M14 8a5 5 0 0 1 0 8"/></svg>公告</h3>
    <div class="notice">
      <p>{site.notice}</p>
    </div>
  </div>

  <!-- 最新动态 -->
  <div class="side-card glass">
    <h3 class="side-card-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>最新动态</h3>
    <div class="moment-list">
      {
        moments.map((m) => (
          <div class="moment-item">
            {m.data.sticky && <span class="sticky-badge">置顶</span>}
            <div class="moment-text">{m.body}</div>
            <span class="moment-date">{formatDateTime(m.data.date)}</span>
          </div>
        ))
      }
    </div>
  </div>

  <!-- 分类 -->
  <div class="side-card glass">
    <h3 class="side-card-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v9a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/></svg>分类</h3>
    <div class="side-tags">
      {
        categoryList.map((cat) => (
          <a class="tag" href={`/category/${encodeURIComponent(cat)}/`}>{cat}</a>
        ))
      }
    </div>
  </div>

  <!-- 标签 -->
  <div class="side-card glass">
    <h3 class="side-card-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2H2v10l9.29 9.29a2 2 0 0 0 2.83 0l7.17-7.17a2 2 0 0 0 0-2.83z"/><circle cx="7" cy="7" r="1"/></svg>标签</h3>
    <div class="side-tags">
      {
        tagList.map((tag) => (
          <a class="tag" href={`/tag/${encodeURIComponent(tag)}/`}>#{tag}</a>
        ))
      }
    </div>
  </div>
</aside>
