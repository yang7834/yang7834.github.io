---
import { getCollection } from 'astro:content';
import site from '../data/site.json';

const posts = await getCollection('blog');
const moments = await getCollection('moments');
const links = await getCollection('links');

const postCount = posts.length;
const categories = new Set<string>();
const tags = new Set<string>();
for (const post of posts) {
  if (post.data.category) categories.add(post.data.category);
  for (const tag of post.data.tags) tags.add(tag);
}

const SITE_TITLE = site.title;
const SITE_CREATED = site.created;
const created = new Date(SITE_CREATED);
const days = Math.floor((Date.now() - created.getTime()) / (1000 * 60 * 60 * 24));
---

<aside class="sidebar">
  <!-- 音乐播放器 -->
  <div class="side-card glass">
    <h3 class="side-card-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M9 18V5l12-2v13"/><circle cx="6" cy="18" r="3"/><circle cx="18" cy="16" r="3"/></svg>音乐</h3>
    <div class="music-player">
      <div class="music-cover" id="musicDisc">
        <img class="music-cover-img" src={site.music.cover} alt="封面" />
      </div>
      <div class="music-info">
        <div class="music-title">{site.music.title}</div>
        <div class="music-artist">{site.music.artist}</div>
      </div>
    </div>
    <div class="music-progress" id="musicProgressBar">
      <div class="music-progress-fill" id="musicProgressFill"></div>
    </div>
    <div class="music-time">
      <span id="musicCurrent">0:00</span>
      <span id="musicDuration">0:00</span>
    </div>
    <div class="music-controls">
      <button class="music-toggle" id="musicToggle" type="button" aria-label="播放">▶</button>
      <div class="music-volume-wrap">
        <span class="music-volume-icon">🔊</span>
        <input class="music-volume" id="musicVolume" type="range" min="0" max="1" step="0.01" value="0.8" aria-label="音量" />
      </div>
    </div>
  </div>

  <!-- 日历 -->
  <div class="side-card glass">
    <h3 class="side-card-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>日历</h3>
    <div class="calendar" id="calendar"></div>
  </div>

  <!-- 站点统计 -->
  <div class="side-card glass">
    <h3 class="side-card-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 3v18h18"/><rect x="7" y="12" width="3" height="6"/><rect x="12" y="8" width="3" height="10"/><rect x="17" y="5" width="3" height="13"/></svg>站点统计</h3>
    <div class="stats-grid">
      <div class="stat-item"><span class="stat-num">{postCount}</span><span class="stat-label">文章</span></div>
      <div class="stat-item"><span class="stat-num">{categories.size}</span><span class="stat-label">分类</span></div>
      <div class="stat-item"><span class="stat-num">{tags.size}</span><span class="stat-label">标签</span></div>
      <div class="stat-item"><span class="stat-num">{moments.length}</span><span class="stat-label">动态</span></div>
      <div class="stat-item"><span class="stat-num">{links.length}</span><span class="stat-label">友链</span></div>
      <div class="stat-item"><span class="stat-num">{days}</span><span class="stat-label">天</span></div>
    </div>
  </div>

  <!-- 站点信息 -->
  <div class="side-card glass">
    <h3 class="side-card-title"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 16v-4M12 8h.01"/></svg>站点信息</h3>
    <ul class="info-list">
      <li><span class="info-label">博客</span><span class="info-value">{SITE_TITLE}</span></li>
      <li><span class="info-label">建站</span><span class="info-value">{SITE_CREATED}</span></li>
      <li><span class="info-label">技术</span><span class="info-value">Astro</span></li>
      <li><span class="info-label">托管</span><span class="info-value">GitHub Pages</span></li>
    </ul>
  </div>
</aside>

<script>
  // 日历（每次导航后重新生成）
  function initCalendar() {
    const calendarEl = document.getElementById('calendar');
    if (calendarEl) {
      const now = new Date();
      const year = now.getFullYear();
      const month = now.getMonth();
      const today = now.getDate();
      const firstDay = new Date(year, month, 1).getDay();
      const daysInMonth = new Date(year, month + 1, 0).getDate();
      const weekdays = ['日', '一', '二', '三', '四', '五', '六'];

      let html = `<div class="calendar-header"><span>${year} 年 ${month + 1} 月</span></div>`;
      html += `<div class="calendar-weekdays">${weekdays.map((w) => `<span>${w}</span>`).join('')}</div>`;
      html += `<div class="calendar-days">`;
      for (let i = 0; i < firstDay; i++) {
        html += `<span class="calendar-day empty"></span>`;
      }
      for (let d = 1; d <= daysInMonth; d++) {
        const cls = d === today ? 'calendar-day today' : 'calendar-day';
        html += `<span class="${cls}">${d}</span>`;
      }
      html += `</div>`;
      calendarEl.innerHTML = html;
    }
  }

  document.addEventListener('astro:page-load', initCalendar);
  initCalendar();
</script>
