---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';
import site from '../data/site.json';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;

const SITE_TITLE = site.title;
const SITE_SUBTITLE = site.subtitle;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : `${SITE_TITLE} · ${SITE_SUBTITLE}`;

type NavItem = {
  label: string;
  href?: string;
  children?: { label: string; href: string; external?: boolean }[];
};

const navItems: NavItem[] = [
  { label: '主页', href: '/' },
  {
    label: '文章',
    children: [
      { label: '归档', href: '/archive/' },
      { label: '标签', href: '/tags/' },
    ],
  },
  {
    label: '社交',
    children: [
      { label: '友链', href: '/links/' },
      { label: '留言', href: '/message/' },
    ],
  },
  {
    label: '我的',
    children: [
      { label: '动态', href: '/moments/' },
      { label: '相册', href: '/photos/' },
      { label: '追番', href: '/anime/' },
      { label: '书签导航', href: '/bookmarks/' },
    ],
  },
  {
    label: '关于',
    children: [
      { label: '打赏', href: '/donate/' },
      { label: '关于我', href: '/about/' },
    ],
  },
  {
    label: '链接',
    children: [
      { label: 'GitHub', href: site.social.github, external: true },
      { label: 'Bilibili', href: site.social.bilibili, external: true },
      { label: '抖音', href: site.social.douyin, external: true },
    ],
  },
];

const posts = await getCollection('blog');
const searchIndex = posts.map((p) => ({
  title: p.data.title,
  description: p.data.description,
  url: `/blog/${p.id}/`,
  tags: p.data.tags,
  category: p.data.category || '',
}));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
  </head>
  <body>
    <div class="bg-layer" style={`background-image: url('${site.background}')`}></div>
    <header class="site-header">
      <a class="site-title" href="/">{SITE_TITLE}</a>
      <nav class="site-nav">
        {
          navItems.map((item) =>
            item.children ? (
              <div class="nav-dropdown">
                <span class="nav-label">{item.label}</span>
                <div class="dropdown-menu">
                  {
                    item.children.map((child) =>
                      child.external ? (
                        <a href={child.href} target="_blank" rel="noopener noreferrer">{child.label}</a>
                      ) : (
                        <a href={child.href}>{child.label}</a>
                      )
                    )
                  }
                </div>
              </div>
            ) : (
              <a href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            )
          )
        }
      </nav>
      <div class="site-search">
        <input type="search" id="searchInput" placeholder="搜索文章..." autocomplete="off" />
        <div class="search-results" id="searchResults"></div>
      </div>
    </header>
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} {SITE_TITLE}</span>
    </footer>

    <audio id="musicAudio" src={site.music.audio} preload="metadata" transition:persist></audio>

    <script define:vars={{ searchIndex }}>
      // 搜索
      const input = document.getElementById('searchInput');
      const results = document.getElementById('searchResults');

      function esc(s) {
        return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
      }

      if (input && results) {
        input.addEventListener('input', () => {
          const q = input.value.trim().toLowerCase();
          if (!q) {
            results.classList.remove('open');
            results.innerHTML = '';
            return;
          }
          const matches = searchIndex
            .filter((item) =>
              [item.title, item.description, item.category, ...item.tags].join(' ').toLowerCase().includes(q)
            )
            .slice(0, 8);

          if (matches.length === 0) {
            results.innerHTML = '<div class="search-empty">没有找到相关文章</div>';
          } else {
            results.innerHTML = matches
              .map(
                (m) =>
                  `<a class="search-item" href="${m.url}"><span class="search-item-title">${esc(m.title)}</span><span class="search-item-desc">${esc(m.description)}</span></a>`
              )
              .join('');
          }
          results.classList.add('open');
        });

        document.addEventListener('click', (e) => {
          if (!e.target.closest('.site-search')) {
            results.classList.remove('open');
          }
        });
      }

      // 音乐播放器（全局 audio + 每次导航后重新绑定 UI + 导航后自动恢复播放）
      const musicAudio = document.getElementById('musicAudio');
      let musicWasPlaying = false;

      function fmtMusic(s) {
        if (!isFinite(s)) return '0:00';
        const m = Math.floor(s / 60);
        const sec = Math.floor(s % 60);
        return `${m}:${String(sec).padStart(2, '0')}`;
      }

      function syncMusicUI() {
        if (!musicAudio) return;
        const toggle = document.getElementById('musicToggle');
        const disc = document.getElementById('musicDisc');
        const current = document.getElementById('musicCurrent');
        const duration = document.getElementById('musicDuration');
        const fill = document.getElementById('musicProgressFill');
        if (toggle) toggle.textContent = musicAudio.paused ? '▶' : '⏸';
        if (disc) {
          if (musicAudio.paused) disc.classList.remove('playing');
          else disc.classList.add('playing');
        }
        if (current) current.textContent = fmtMusic(musicAudio.currentTime);
        if (duration) duration.textContent = fmtMusic(musicAudio.duration);
        if (fill && musicAudio.duration) {
          fill.style.width = (musicAudio.currentTime / musicAudio.duration) * 100 + '%';
        }
      }

      function initMusic() {
        if (!musicAudio) return;
        musicAudio.volume = 0.8;
        const toggle = document.getElementById('musicToggle');
        const volumeEl = document.getElementById('musicVolume');
        const progressBar = document.getElementById('musicProgressBar');
        if (volumeEl) volumeEl.value = musicAudio.volume;
        if (toggle) {
          toggle.onclick = () => {
            if (musicAudio.paused) {
              musicAudio.play().then(() => {
                musicWasPlaying = true;
                syncMusicUI();
              }).catch(() => {});
            } else {
              musicAudio.pause();
              musicWasPlaying = false;
              syncMusicUI();
            }
          };
        }
        if (volumeEl) {
          volumeEl.oninput = () => {
            musicAudio.volume = parseFloat(volumeEl.value);
          };
        }
        if (progressBar) {
          progressBar.onclick = (e) => {
            const rect = progressBar.getBoundingClientRect();
            const ratio = (e.clientX - rect.left) / rect.width;
            if (musicAudio.duration) musicAudio.currentTime = ratio * musicAudio.duration;
          };
        }
        syncMusicUI();
      }

      if (musicAudio) {
        musicAudio.addEventListener('loadedmetadata', syncMusicUI);
        musicAudio.addEventListener('timeupdate', syncMusicUI);
        musicAudio.addEventListener('ended', () => {
          musicWasPlaying = false;
          syncMusicUI();
        });
      }

      document.addEventListener('astro:page-load', () => {
        initMusic();
        if (musicWasPlaying && musicAudio && musicAudio.paused) {
          musicAudio.play().then(syncMusicUI).catch(() => {});
        }
      });
      initMusic();
    </script>
  </body>
</html>
