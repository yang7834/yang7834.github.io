---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import { getCollection } from 'astro:content';
import site from '../data/site.json';
import Icon from '../components/Icon.astro';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;

const SITE_TITLE = site.title;
const SITE_SUBTITLE = site.subtitle;
const pageTitle = title ? `${title} · ${SITE_TITLE}` : `${SITE_TITLE}丨${SITE_SUBTITLE}`;

type NavItem = {
  label: string;
  href?: string;
  icon?: string;
  children?: { label: string; href: string; external?: boolean }[];
};

const navItems: NavItem[] = [
  { label: '主页', href: '/', icon: 'home' },
  {
    label: '文章',
    icon: 'article',
    children: [
      { label: '归档', href: '/archive/' },
      { label: '标签', href: '/tags/' },
    ],
  },
  {
    label: '社交',
    icon: 'social',
    children: [
      { label: '友链', href: '/links/' },
      { label: '留言', href: '/message/' },
    ],
  },
  {
    label: '我的',
    icon: 'me',
    children: [
      { label: '动态', href: '/moments/' },
      { label: '相册', href: '/photos/' },
      { label: '追番', href: '/anime/' },
      { label: '书签导航', href: '/bookmarks/' },
    ],
  },
  {
    label: '关于',
    icon: 'about',
    children: [
      { label: '打赏', href: '/donate/' },
      { label: '关于我', href: '/about/' },
    ],
  },
  {
    label: '链接',
    icon: 'link',
    children: [
      { label: 'GitHub', href: site.social.github, external: true },
      { label: 'Bilibili', href: site.social.bilibili, external: true },
      { label: '抖音', href: site.social.douyin, external: true },
    ],
  },
];

const posts = await getCollection('blog');
const searchIndex = posts.map((p) => ({
  title: p.data.title,
  description: p.data.description,
  url: `/blog/${p.id}/`,
  tags: p.data.tags,
  category: p.data.category || '',
}));
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ececec" />
    <title>{pageTitle}</title>
    <link rel="icon" type="image/png" href="/favicon.png" />
    <link rel="preconnect" href="https://giscus.app" />
    <link rel="preconnect" href="https://eohtftdqtxbkryaktqrt.supabase.co" />
    {description && <meta name="description" content={description} />}
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />
  </head>
  <body>
    <div class="bg-layer" style={`background-image: url('${site.background}')`}></div>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <header class="site-header">
      <a class="site-title" href="/">{SITE_TITLE}</a>
      <nav class="site-nav">
        {
          navItems.map((item) =>
            item.children ? (
              <div class="nav-dropdown">
                <button class="nav-label" type="button">
                  {item.icon && <span class="nav-icon"><Icon name={item.icon} /></span>}
                  <span>{item.label}</span>
                </button>
                <div class="dropdown-menu">
                  {
                    item.children.map((child) =>
                      child.external ? (
                        <a href={child.href} target="_blank" rel="noopener noreferrer">{child.label}</a>
                      ) : (
                        <a href={child.href}>{child.label}</a>
                      )
                    )
                  }
                </div>
              </div>
            ) : (
              <a href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>
                {item.icon && <span class="nav-icon"><Icon name={item.icon} /></span>}
                <span>{item.label}</span>
              </a>
            )
          )
        }
      </nav>
      <div class="site-search">
        <svg class="search-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="11" cy="11" r="8"/><path d="M21 21l-4.35-4.35"/></svg>
        <input type="search" id="searchInput" placeholder="搜索文章…" autocomplete="off" aria-label="搜索文章" />
        <div class="search-results" id="searchResults"></div>
      </div>
    </header>
    <main class="site-main" id="main-content">
      <slot />
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} {SITE_TITLE}</span>
      <span class="footer-sep">·</span>
      <span class="footer-stat">今日 <b id="statToday">-</b></span>
      <span class="footer-stat">本月 <b id="statMonth">-</b></span>
      <span class="footer-stat">总访问 <b id="statTotal">-</b></span>
    </footer>

    <audio id="musicAudio" src={site.music.audio} preload="metadata" transition:persist></audio>

    <script define:vars={{ searchIndex }}>
      // 下拉菜单：点击切换，点击外部关闭
      function initNavDropdown() {
        document.querySelectorAll('.nav-dropdown').forEach((dd) => {
          const btn = dd.querySelector('.nav-label');
          if (btn && !btn.dataset.bound) {
            btn.dataset.bound = '1';
            btn.addEventListener('click', () => {
              const wasOpen = dd.classList.contains('open');
              document.querySelectorAll('.nav-dropdown.open').forEach((d) => d.classList.remove('open'));
              if (!wasOpen) dd.classList.add('open');
            });
          }
        });
      }
      document.addEventListener('click', (e) => {
        if (!e.target.closest('.nav-dropdown')) {
          document.querySelectorAll('.nav-dropdown.open').forEach((d) => d.classList.remove('open'));
        }
      });
      document.addEventListener('astro:page-load', initNavDropdown);
      initNavDropdown();

      // 搜索
      const input = document.getElementById('searchInput');
      const results = document.getElementById('searchResults');

      function esc(s) {
        return String(s).replace(/[&<>"']/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]));
      }

      if (input && results) {
        input.addEventListener('input', () => {
          const q = input.value.trim().toLowerCase();
          if (!q) {
            results.classList.remove('open');
            results.innerHTML = '';
            return;
          }
          const matches = searchIndex
            .filter((item) =>
              [item.title, item.description, item.category, ...item.tags].join(' ').toLowerCase().includes(q)
            )
            .slice(0, 8);

          if (matches.length === 0) {
            results.innerHTML = '<div class="search-empty">没有找到相关文章</div>';
          } else {
            results.innerHTML = matches
              .map(
                (m) =>
                  `<a class="search-item" href="${m.url}"><span class="search-item-title">${esc(m.title)}</span><span class="search-item-desc">${esc(m.description)}</span></a>`
              )
              .join('');
          }
          results.classList.add('open');
        });

        document.addEventListener('click', (e) => {
          if (!e.target.closest('.site-search')) {
            results.classList.remove('open');
          }
        });
      }

      // 音乐播放器（全局 audio，导航导致暂停时自动恢复）
      const musicAudio = document.getElementById('musicAudio');
      let shouldPlay = false;

      function fmtMusic(s) {
        if (!isFinite(s)) return '0:00';
        const m = Math.floor(s / 60);
        const sec = Math.floor(s % 60);
        return `${m}:${String(sec).padStart(2, '0')}`;
      }

      function syncMusicUI() {
        if (!musicAudio) return;
        const toggle = document.getElementById('musicToggle');
        const disc = document.getElementById('musicDisc');
        const current = document.getElementById('musicCurrent');
        const duration = document.getElementById('musicDuration');
        const fill = document.getElementById('musicProgressFill');
        if (toggle) toggle.textContent = musicAudio.paused ? '▶' : '⏸';
        if (disc) {
          if (musicAudio.paused) disc.classList.remove('playing');
          else disc.classList.add('playing');
        }
        if (current) current.textContent = fmtMusic(musicAudio.currentTime);
        if (duration) duration.textContent = fmtMusic(musicAudio.duration);
        if (fill && musicAudio.duration) {
          fill.style.width = (musicAudio.currentTime / musicAudio.duration) * 100 + '%';
        }
      }

      function initMusic() {
        if (!musicAudio) return;
        musicAudio.volume = 0.8;
        const toggle = document.getElementById('musicToggle');
        const volumeEl = document.getElementById('musicVolume');
        const progressBar = document.getElementById('musicProgressBar');
        if (volumeEl) volumeEl.value = musicAudio.volume;
        if (toggle) {
          toggle.onclick = () => {
            if (musicAudio.paused) {
              shouldPlay = true;
              musicAudio.play().then(syncMusicUI).catch(() => {});
            } else {
              shouldPlay = false;
              musicAudio.pause();
              syncMusicUI();
            }
          };
        }
        if (volumeEl) {
          volumeEl.oninput = () => {
            musicAudio.volume = parseFloat(volumeEl.value);
          };
        }
        if (progressBar) {
          progressBar.onclick = (e) => {
            const rect = progressBar.getBoundingClientRect();
            const ratio = (e.clientX - rect.left) / rect.width;
            if (musicAudio.duration) musicAudio.currentTime = ratio * musicAudio.duration;
          };
        }
        syncMusicUI();
      }

      if (musicAudio) {
        musicAudio.addEventListener('loadedmetadata', syncMusicUI);
        musicAudio.addEventListener('timeupdate', syncMusicUI);
        musicAudio.addEventListener('play', syncMusicUI);
        musicAudio.addEventListener('ended', () => {
          shouldPlay = false;
          syncMusicUI();
        });
        musicAudio.addEventListener('pause', () => {
          // 导航导致的暂停，自动恢复
          if (shouldPlay) {
            setTimeout(() => {
              if (shouldPlay && musicAudio.paused) {
                musicAudio.play().catch(() => {});
              }
            }, 120);
          }
        });
      }

      document.addEventListener('astro:page-load', initMusic);
      initMusic();

      // 访问量统计（Supabase）
      const SUPABASE_URL = 'https://eohtftdqtxbkryaktqrt.supabase.co';
      const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImVvaHRmdGRxdHhia3J5YWt0cXJ0Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODY3MTAwNDMsImV4cCI6MjEwMjI4NjA0M30.ZhyQEbRrpVBkyH80Ws2mxuny4s1Ew7RxHDJ1IJ4HNXI';

      async function recordVisit() {
        const date = new Date().toISOString().slice(0, 10);
        try {
          await fetch(`${SUPABASE_URL}/rest/v1/visits`, {
            method: 'POST',
            headers: {
              apikey: SUPABASE_KEY,
              Authorization: `Bearer ${SUPABASE_KEY}`,
              'Content-Type': 'application/json',
              Prefer: 'return=minimal'
            },
            body: JSON.stringify({ date })
          });
        } catch (e) {}
      }

      async function visitCount(query) {
        try {
          const res = await fetch(`${SUPABASE_URL}/rest/v1/visits?select=id${query}`, {
            headers: {
              apikey: SUPABASE_KEY,
              Authorization: `Bearer ${SUPABASE_KEY}`,
              Prefer: 'count=exact',
              Range: '0-0'
            }
          });
          const range = res.headers.get('content-range');
          return range ? parseInt(range.split('/')[1]) : 0;
        } catch (e) {
          return 0;
        }
      }

      async function loadStats() {
        const today = new Date().toISOString().slice(0, 10);
        const monthStart = today.slice(0, 7) + '-01';
        const [total, todayN, monthN] = await Promise.all([
          visitCount(''),
          visitCount(`&date=eq.${today}`),
          visitCount(`&date=gte.${monthStart}&date=lte.${today}`)
        ]);
        const setEl = (id, v) => { const e = document.getElementById(id); if (e) e.textContent = v; };
        setEl('statToday', todayN);
        setEl('statMonth', monthN);
        setEl('statTotal', total);
      }

      recordVisit();
      loadStats();

      // 标签页标题动态变化（切走"页面已丢失"，切回"骗你的欢迎回来"→3秒后恢复）
      let realTitle = document.title;
      let titleTimer = null;
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          if (titleTimer) { clearTimeout(titleTimer); titleTimer = null; }
          realTitle = document.title;
          document.title = '页面已丢失…';
        } else {
          document.title = '骗你的，欢迎回来';
          if (titleTimer) clearTimeout(titleTimer);
          titleTimer = setTimeout(() => {
            document.title = realTitle;
            titleTimer = null;
          }, 3000);
        }
      });
      document.addEventListener('astro:page-load', () => {
        if (!document.hidden) {
          realTitle = document.title;
        }
      });
    </script>
  </body>
</html>
