---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const { title, description } = Astro.props;

const SITE_TITLE = 'yang7834';
const SITE_SUBTITLE = '个人博客';
const pageTitle = title ? `${title} · ${SITE_TITLE}` : `${SITE_TITLE} · ${SITE_SUBTITLE}`;

type NavItem = {
  label: string;
  href?: string;
  children?: { label: string; href: string; external?: boolean }[];
};

const navItems: NavItem[] = [
  { label: '主页', href: '/' },
  {
    label: '文章',
    children: [
      { label: '归档', href: '/archive/' },
      { label: '标签', href: '/tags/' },
    ],
  },
  {
    label: '社交',
    children: [
      { label: '友链', href: '/links/' },
      { label: '留言', href: '/message/' },
    ],
  },
  {
    label: '我的',
    children: [
      { label: '动态', href: '/moments/' },
      { label: '相册', href: '/photos/' },
      { label: '追番', href: '/anime/' },
      { label: '书签导航', href: '/bookmarks/' },
    ],
  },
  {
    label: '关于',
    children: [
      { label: '打赏', href: '/donate/' },
      { label: '关于我', href: '/about/' },
    ],
  },
  {
    label: '链接',
    children: [
      { label: 'GitHub', href: 'https://github.com/yang7834', external: true },
      { label: 'Bilibili', href: 'https://space.bilibili.com/', external: true },
      { label: '抖音', href: 'https://www.douyin.com/', external: true },
    ],
  },
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta name="generator" content={Astro.generator} />
  </head>
  <body>
    <div class="bg-layer"></div>
    <header class="site-header">
      <a class="site-title" href="/">{SITE_TITLE}</a>
      <nav class="site-nav">
        {
          navItems.map((item) =>
            item.children ? (
              <div class="nav-dropdown">
                <span class="nav-label">{item.label}</span>
                <div class="dropdown-menu">
                  {
                    item.children.map((child) =>
                      child.external ? (
                        <a href={child.href} target="_blank" rel="noopener noreferrer">{child.label}</a>
                      ) : (
                        <a href={child.href}>{child.label}</a>
                      )
                    )
                  }
                </div>
              </div>
            ) : (
              <a href={item.href} aria-current={Astro.url.pathname === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            )
          )
        }
      </nav>
    </header>
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">
      <span>© {new Date().getFullYear()} {SITE_TITLE}</span>
    </footer>
  </body>
</html>
